{
  "database": {
    "url": "postgres://aidev:aidev@127.0.0.1:5434/aidev?sslmode=disable"
  },
  "workspace_root": "/home/you/.local/share/aidev/worktrees",
  "tasks": {
    "timeout": "30m",
    "verification_timeout": "10m",
    "max_output_bytes": 1048576,
    "worktree_cleanup": "on-success"
  },
  "agent": {
    "backend": "opencode",
    "opencode": {
      "command": "opencode",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "agent": "build"
    },
    "codex": {
      "command": "codex",
      "profile": "",
      "model": "",
      "sandbox": "workspace-write"
    }
  },
  "log_level": "info",
  "tracing": {
    "endpoint": "",
    "traces_endpoint": "",
    "headers": {},
    "service_name": "",
    "sample_ratio": 1
  }
}
