# Copy to .env and adjust. aidev reads its configuration from the environment;
# these are the variables it understands.

# Required. Must match docker-compose.yml (host port defaults to 5434).
DATABASE_URL=postgres://aidev:aidev@127.0.0.1:5434/aidev?sslmode=disable

# Where task worktrees are created. Every worktree must resolve inside this
# directory. Defaults to $XDG_DATA_HOME/aidev/worktrees, or
# ~/.local/share/aidev/worktrees.
#WORKSPACE_ROOT=/home/you/.local/share/aidev/worktrees

# Bounds one agent run. Generous on purpose: OpenCode's first run against a
# repository it has not seen can take minutes (docs/research.md 2.9).
#DEFAULT_TASK_TIMEOUT=30m

# Bounds one verification step.
#DEFAULT_VERIFICATION_TIMEOUT=10m

# The OpenCode executable, and optional model/agent defaults. An empty model
# lets OpenCode choose, which works without credentials (docs/research.md 2.10).
#OPENCODE_COMMAND=opencode
#OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free
#OPENCODE_AGENT=build

# Per-stream capture limit in bytes. Output beyond it is dropped and flagged.
#MAX_OUTPUT_BYTES=1048576

# What happens to a worktree when its task finishes.
#   on-success  commit the work to the task branch, then remove the directory
#   never       keep every worktree on disk
# Neither policy discards a failed attempt's work.
#WORKTREE_CLEANUP=on-success

# debug | info | warn | error. Logs are JSON on stderr, always.
#LOG_LEVEL=info

# Used only by integration tests. When unset, database tests skip.
#TEST_DATABASE_URL=postgres://aidev:aidev@127.0.0.1:5434/aidev_test?sslmode=disable
